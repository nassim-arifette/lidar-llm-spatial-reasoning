report/*.log

# Data and run outputs. Datasets are downloaded, not committed; results that
# a document cites are committed under spatial_reasoning/results/.
data/data/
outputs/
*.pt
*.ckpt

# Secrets. The repository is public: nothing holding a credential may be
# tracked. Nothing in the experiments needs one -- the comparison runs on
# open weights -- so this is insurance, not configuration.
.env
.env.*
*.key
*.pem
secrets.json
