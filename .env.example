# Copy this file to .env and fill in the values. .env is gitignored; this
# file is tracked and must never hold a real credential.
#
#   cp .env.example .env
#
# Nothing in the experiments requires either of these. The parser comparison
# runs Qwen from open weights on the Colab GPU, which needs no account and
# keeps the decoding loop local -- grammar-constrained generation masks logits
# during sampling, and a hosted endpoint does not expose them.

# Only if you route generation through a hosted gateway instead of local
# weights. Doing so forfeits constrained decoding.
AI_GATEWAY_API_KEY=

# Only for gated Hugging Face checkpoints. The Qwen models used here are not
# gated, so this is usually left empty.
HF_TOKEN=
